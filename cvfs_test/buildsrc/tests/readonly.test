# Read-only behaviour, which the writable native tree cannot provide expected
# results for

package require tcltest 2.5
::tcltest::configure {*}$::argv
source [file join [file dirname [file normalize [info script]]] common.tcl]

namespace eval ::cvfs_test::test {
	namespace import ::tcltest::*

	variable file [::cvfs_test::path lib/foo/a.txt]
	variable dir [::cvfs_test::path lib]

	test readonly-1.1 {F7: opening a directory fails with EISDIR} -setup ::cvfs_test::clear_errno -body {
		open $dir
	} -errorCode {POSIX EISDIR *} -match glob -result *

	test readonly-1.2 {opening for writing fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		open $file w
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.3 {opening for appending fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		open $file a
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.4 {opening for reading and writing fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		open $file r+
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.5 {file delete fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		file delete $file
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.6 {file mkdir fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		file mkdir [::cvfs_test::path newdir]
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.7 {F15: setting the mtime fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		file mtime $file 5
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-1.8 {setting permissions fails with EROFS} -setup ::cvfs_test::clear_errno -body {
		file attributes $file -permissions 0o777
	} -errorCode {POSIX EROFS *} -match glob -result *

	test readonly-2.1 {F14: a file is not writable} -body {
		file writable $file
	} -result 0

	test readonly-2.2 {F14: a directory is not writable} -body {
		file writable $dir
	} -result 0

	# Same format as the native filesystem's -permissions
	test readonly-3.1 {F16: permissions of a file} -body {
		file attributes $file -permissions
	} -result [format %0#5o 0o444]

	test readonly-3.2 {F16: permissions of a directory} -body {
		file attributes $dir -permissions
	} -result [format %0#5o 0o40555]

	# The permission part of -types, which tclvfs applies with Tcl_FSAccess:
	# nothing is writable, and only directories are executable
	variable all [dict get $::cvfs_test::manifest entries lib children]
	variable dirs [list]
	foreach child $all {
		if {[dict get $::cvfs_test::manifest entries lib/$child type] eq "directory"} {
			lappend dirs $child
		}
	}

	test readonly-4.1 {F18: glob -types w finds nothing} -body {
		lsort [glob -nocomplain -tails -types w -directory $dir *]
	} -result {}

	test readonly-4.2 {F18: glob -types readonly finds everything} -body {
		lsort [glob -nocomplain -tails -types readonly -directory $dir *]
	} -result $all

	test readonly-4.3 {F18: glob -types r finds everything} -body {
		lsort [glob -nocomplain -tails -types r -directory $dir *]
	} -result $all

	test readonly-4.4 {F18: glob -types x finds only directories} -body {
		lsort [glob -nocomplain -tails -types x -directory $dir *]
	} -result $dirs

	test readonly-4.5 {F18: glob -types {f x} finds nothing} -body {
		lsort [glob -nocomplain -tails -types {f x} -directory $dir *]
	} -result {}

	cleanupTests
}
namespace delete ::cvfs_test::test
