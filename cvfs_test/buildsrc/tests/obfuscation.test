# With -constraints obfuscated: file contents must not appear as plain bytes
# in the binary.  secret.bin is random, so compression stores it unchanged and
# only obfuscation hides it.

package require tcltest 2.5
::tcltest::configure {*}$::argv
source [file join [file dirname [file normalize [info script]]] common.tcl]

namespace eval ::cvfs_test::test {
	namespace import ::tcltest::*

	# A kit is mounted on its own path, so reading the executable reaches the
	# VFS root; read the file underneath with the mount removed for the moment
	proc read_native {path} {
		if {[lindex [file system $path] 0] ne "tclvfs"} {
			return [::cvfs_test::read_file $path]
		}

		set handler [vfs::filesystem info $path]
		vfs::filesystem unmount $path
		try {
			return [::cvfs_test::read_file $path]
		} finally {
			vfs::filesystem mount $path $handler
		}
	}

	test obfuscation-1.1 {secret.bin is not stored as plain bytes in the binary} -constraints obfuscated -body {
		variable needle [string range [::cvfs_test::read_file [::cvfs_test::path secret.bin]] 0 63]
		string first $needle [read_native $::cvfs_test::binary]
	} -result -1

	cleanupTests
}
namespace delete ::cvfs_test::test
